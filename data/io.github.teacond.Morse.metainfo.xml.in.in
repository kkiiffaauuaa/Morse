<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Morse</name>
  <summary>Learn Morse Code</summary>
  <description>
    <p>Learn Morse Code and High Speed Telegraphy.</p>
  </description>

  <categories>
    <category>Audio</category>
    <category>Education</category>
    <category>GNOME</category>
    <category>GTK</category>
  </categories>
  
  <developer_name translate="no">Jaŭhien Lavonćjeŭ</developer_name>
  <developer id="io.github.teacond">
    <name translate="no">Jaŭhien Lavonćjeŭ</name>
  </developer>

  <url type="homepage">https://github.com/teacond/Morse</url>
  <url type="vcs-browser">https://github.com/teacond/Morse</url>
  <url type="bugtracker">https://github.com/teacond/Morse/issues</url>
  <url type="translate">https://hosted.weblate.org/projects/morse-app</url>

  <translation type="gettext">morse</translation>
  <!-- All graphical applications having a desktop file must have this tag in the MetaInfo.
     If this is present, appstreamcli compose will pull icons, keywords and categories from the desktop file. -->
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <!-- Use the OARS website (https://hughsie.github.io/oars/generate.html) to generate these and make sure to use oars-1.1 -->
  <content_rating type="oars-1.1" />

  <!-- Applications should set a brand color in both light and dark variants like so -->
  <branding>
    <color type="primary" scheme_preference="light">#DEB13E</color>
    <color type="primary" scheme_preference="dark">#402D2E</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/teacond/Morse/main/data/screenshots/overview-light.png</image>
      <caption>An overview</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/teacond/Morse/main/data/screenshots/overview-dark.png</image>
      <caption>An overview</caption>
    </screenshot>
  </screenshots>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <control>tablet</control>
  </supports>

  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>

  <releases>
    <release version="1.0.6" date="2026-01-24">
      <description translate="no">
        <p>
          Improvements:
        </p>
        <ul>
          <li>"Auto Generation" switch is now disabled by default</li>
        </ul>
        <p>
          Localisation:
        </p>
        <ul>
          <li>Added Finnish translation</li>
          <li>Added Belarusian translation</li>
          <li>Added Belarusian (Latin script) translation</li>
        </ul>
      </description>
    </release>
    <release version="1.0.5" date="2026-01-22">
      <description translate="no">
        <ul>
          <li>Added Italian translation</li>
        </ul>
      </description>
    </release>
    <release version="1.0.4" date="2026-01-20">
      <description translate="no">
        <ul>
          <li>Added Belarusian (Taraškievica) translation</li>
          <li>Added Polish translation</li>
          <li>Added Thai translation</li>
        </ul>
      </description>
    </release>
    <release version="1.0.1" date="2026-01-18">
      <description translate="no">
        <ul>
          <li>Added Russian translation</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2026-01-17">
      <description translate="no">
        <p>The initial release</p>
      </description>
    </release>
  </releases>

</component>
