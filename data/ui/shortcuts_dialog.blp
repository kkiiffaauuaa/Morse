using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");
    Adw.ShortcutsItem {
      title: _("Show Shortcuts");
      action-name: "app.shortcuts";
    }
    Adw.ShortcutsItem {
      title: _("Show Alphabet");
      action-name: "app.alphabet";
    }
    Adw.ShortcutsItem {
      title: _("Open Menu");
      accelerator: "F10";
    }
    Adw.ShortcutsItem {
      title: _("Open Preferences");
      action-name: "app.preferences";
    }
    Adw.ShortcutsItem {
      title: _("Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: _("Playback");
    Adw.ShortcutsItem {
      title: _("Toggle Playback");
      action-name: "win.toggle-playback";
    }
    Adw.ShortcutsItem {
      title: _("Toggle Mute");
      action-name: "volume.toggle-mute";
    }
    Adw.ShortcutsItem {
      title: _("Increase Volume");
      action-name: "volume.increase";
    }
    Adw.ShortcutsItem {
      title: _("Decrease Volume");
      action-name: "volume.decrease";
    }
  }
}
