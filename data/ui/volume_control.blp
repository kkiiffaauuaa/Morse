using Gtk 4.0;

template $MorseVolumeControl: Widget {
  name: "volume";
  css-classes: ["toolbar"];
  accessible-role: group;
  layout-manager: Gtk.BoxLayout {};
  
  Button volume_low_button {
    icon-name: "audio-volume-low-symbolic";
    action-name: "volume.toggle-mute";
    valign: center;
    tooltip-text: _("Toggle Mute");
    margin-start: 6;

    styles [
      "flat",
      "circular",
    ]
  }

  Scale volume_scale {
    hexpand: true;
    margin-end: 6;

    adjustment: volume_adjustment;

    accessibility {
      label: _("Volume");
    }
  }
}

Adjustment volume_adjustment {
  lower: 0.0;
  upper: 1.0;
  step-increment: 0.05;
  value: 0.5;
}