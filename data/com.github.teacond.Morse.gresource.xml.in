<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="@PATH_ID@">
    <file preprocess="xml-stripblanks">ui/window.ui</file>
    <file preprocess="xml-stripblanks">ui/preferences_dialog.ui</file>
    <file preprocess="xml-stripblanks" alias="shortcuts-dialog.ui">ui/shortcuts_dialog.ui</file>
    <file preprocess="xml-stripblanks">ui/volume_control.ui</file>

    <file preprocess="xml-stripblanks">icons/scalable/actions/dice-symbolic.svg</file>
    <file preprocess="xml-stripblanks">icons/scalable/actions/dock-left-symbolic.svg</file>
    
    <file compressed="true" alias="style.css">ui/style.css</file>
  </gresource>
</gresources>
