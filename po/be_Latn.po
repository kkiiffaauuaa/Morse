#: data/ui/shortcuts_dialog.blp:40
msgid "Increase Volume"
msgstr "Pavialičyć hučnasć"

#: data/ui/shortcuts_dialog.blp:44
msgid "Decrease Volume"
msgstr "Pamienšyć hučnasć"

#: data/ui/volume_control.blp:29
msgid "Volume"
msgstr "Hučnasć"

#: data/ui/window.blp:56 data/ui/window.blp:153
msgid "Main Menu"
msgstr "Hałoŭnaje mieniu"

#: data/ui/window.blp:63
msgid "Back"
msgstr "Nazad"

#: data/ui/window.blp:80
msgid "Text Type"
msgstr "Typ tekstu"

#: data/ui/window.blp:85
msgid "Mixed"
msgstr "Zmiešany"

#: data/ui/window.blp:90
msgid "Auto Generation"
msgstr "Aŭtamatyčnaja hienieracyja"

#: data/ui/window.blp:91
msgid "Pressing the playback button will generate the new text"
msgstr "Naciskannie knopki prajhravannia zhienieruje novy tekst"

#: data/ui/window.blp:96
msgid "Text Generation"
msgstr "Hienieracyja tekstu"

#: data/ui/window.blp:98
msgid "Default word count"
msgstr "Standartnaja kolkasć słoŭ"

#: data/ui/window.blp:99
msgid "The word count is calculated automatically based on the text speed"
msgstr "Kolkasć słoŭ ličycca aŭtamatyčna, hruntujučysia na chutkasci"

#: data/ui/window.blp:103
msgid "Words"
msgstr "Słovy"

#: data/ui/window.blp:108
msgid "Characters"
msgstr "Znaki"

#: data/ui/window.blp:109
msgid "Select the characters you need"
