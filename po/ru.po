#: data/ui/preferences_dialog.blp:23
msgid "Speed System"
msgstr "Система скорости"

#: data/ui/preferences_dialog.blp:24
msgid ""
"Choose PARIS for standard text (50 dots) and CODEX for random groups (60 "
"dots)"
msgstr ""
"Выберите PARIS для обычного текста (50 точек) или CODEX для случайных групп "
"(60 точек)"

#: data/ui/preferences_dialog.blp:33
msgid "Adapt Speed"
msgstr "Адаптивная скорость"

#: data/ui/preferences_dialog.blp:34
msgid ""
"Adjusts speed to a 1-minute duration (default word count) based on the "
"selected text type. Available only for the CODEX speed system."
msgstr ""
"Приводит скорость к одноминутной длине (стандартное кол-во слов) основываясь "
"на выбранном типе текста. Доступно только для системы CODEX."

#: data/ui/preferences_dialog.blp:37
msgid "Default Speed"
msgstr "Скорость по умолчанию"

#: data/ui/preferences_dialog.blp:38
msgid "This speed will be used in the morse code chart"
msgstr "Эта скорость будет использована в таблице азбуки Морзе"

#: data/ui/preferences_dialog.blp:43 data/ui/shortcuts_dialog.blp:30
msgid "Playback"
msgstr "Проигрывание"

#: data/ui/preferences_dialog.blp:45
msgid "Additions"
msgstr "Дополнения"

#: data/ui/preferences_dialog.blp:46
msgid ""
"Controls the start and end of the text. “Default” plays “VVV =”. "
"“Competitions” plays five groups of “OOO” or “00000” (depending on text "
"type), then current speed, and “VVV =”."
msgstr ""
"Управляет началом и концом текста. “Стандартные” проигрывают “VVV =”. "
"“Соревнования” проигрывают 5 групп “ООО” или “00000” (основываясь на типе "
"текста), затем текущую скорость и “VVV =”."

#: data/ui/preferences_dialog.blp:49
msgid "None"
msgstr "Ничего"

#: data/ui/preferences_dialog.blp:50
msgid "Default"
msgstr "Стандартные"

#: data/ui/preferences_dialog.blp:51
msgid "Competitions"
msgstr "Соревнования"

#: data/ui/preferences_dialog.blp:56
msgid "Start Delay"
msgstr "Начальная задержка"

#: data/ui/preferences_dialog.blp:57
msgid "Delay in seconds before the text starts playing"
msgstr "Задержка в секундах перед началом проигрывания текста"

