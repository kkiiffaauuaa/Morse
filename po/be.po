#: data/ui/preferences_dialog.blp:23
msgid "Speed System"
msgstr "Сістэма хуткасці"

#: data/ui/preferences_dialog.blp:24
msgid ""
"Choose PARIS for standard text (50 dots) and CODEX for random groups (60 "
"dots)"
msgstr ""
"Выберыце PARIS для стандартнага тэксту (50 кропак) альбо CODEX для "
"выпадковых груп (60 кропак)"

#: data/ui/preferences_dialog.blp:33
msgid "Adapt Speed"
msgstr "Адаптыўная хуткасць"

#: data/ui/preferences_dialog.blp:34
msgid ""
"Adjusts speed to a 1-minute duration (default word count) based on the "
"selected text type. Available only for the CODEX speed system."
msgstr ""
"Дастасоўвае хуткасць да аднахвіліннай даўжыні (стандартная колькасць слоў) "
"базуючысь на выбраным тыпе тэксту. Даступна толькі для сістэмы CODEX."

#: data/ui/preferences_dialog.blp:37
msgid "Default Speed"
msgstr "Хуткасць па змаўчанні"

#: data/ui/preferences_dialog.blp:38
msgid "This speed will be used in the morse code chart"
msgstr "Гэтая хуткасць будзе выкарыстана ў табліцы азбукі Морзэ"

#: data/ui/preferences_dialog.blp:43 data/ui/shortcuts_dialog.blp:30
msgid "Playback"
msgstr "Прайграванне"

#: data/ui/preferences_dialog.blp:45
msgid "Additions"
msgstr "Дадаткі"

#: data/ui/preferences_dialog.blp:46
msgid ""
"Controls the start and end of the text. “Default” plays “VVV =”. "
"“Competitions” plays “OOOOO” or “00000” (depending on text type), then "
"current speed, and “VVV =”."
msgstr ""
"Кантралюе пачатак і канец тэксту. “Стандартныя” грае “VVV =”. “Спарбоніцтвы” "
"грае “OOOOO” альбо “00000” (у залежнасці ад тыпу тэксту), пазней бягучую "
"хуткасць і “VVV =”."

#: data/ui/preferences_dialog.blp:49
msgid "None"
msgstr "Нічога"

#: data/ui/preferences_dialog.blp:50
msgid "Default"
msgstr "Стандартныя"

#: data/ui/preferences_dialog.blp:51
msgid "Competitions"
msgstr "Спарбоніцтвы"

#: data/ui/preferences_dialog.blp:56
msgid "Start Delay"
msgstr "Пачатковая затрымка"

#: data/ui/preferences_dialog.blp:57
msgid "Delay in seconds before the text starts playing"
msgstr "Затрымка ў секундах перад пачаткам прайгравання тэксту"

#: data/ui/preferences_dialog.blp:62
msgid "Sound"
msgstr "Гук"

#: data/ui/preferences_dialog.blp:64
msgid "Wave Type"
msgstr "Тып хвалі"

#: data/ui/preferences_dialog.blp:67
msgid "Square"
msgstr "Квадрат"

#: data/ui/preferences_dialog.blp:68
msgid "Triangle"
msgstr "Трохкутнік"

#: data/ui/preferences_dialog.blp:69
msgid "Sawtooth"
msgstr "Піла"

#: data/ui/preferences_dialog.blp:70
msgid "Sine"
msgstr "Сінусоіда"

#: data/ui/preferences_dialog.blp:75
msgid "Frequency"
msgstr "Частата"

#: data/ui/shortcuts_dialog.blp:8
msgid "Show Shortcuts"
msgstr "Паказаць скароты клавішаў"

#: data/ui/shortcuts_dialog.blp:12
msgid "Show Alphabet"
msgstr "Паказаць алфавіт"

#: data/ui/shortcuts_dialog.blp:16
msgid "Open Menu"
msgstr "Адкрыць меню"

#: data/ui/shortcuts_dialog.blp:20
msgid "Open Preferences"
msgstr "Адкрыць налады"

#: data/ui/shortcuts_dialog.blp:24
msgid "Quit"
msgstr "Выйсці"

#: data/ui/shortcuts_dialog.blp:32
msgid "Toggle Playback"
msgstr "Укл/Выкл прайграванне"

#: data/ui/shortcuts_dialog.blp:36 data/ui/volume_control.blp:13
msgid "Toggle Mute"
msgstr "Укл/Выкл гук"

#: data/ui/shortcuts_dialog.blp:40
msgid "Increase Volume"
msgstr "Павялічыць гучнасць"

#: data/ui/shortcuts_dialog.blp:44
msgid "Decrease Volume"
msgstr "Паменшыць гучнасць"

#: data/ui/volume_control.blp:29
msgid "Volume"
msgstr "Гучнасць"

#: data/ui/window.blp:56 data/ui/window.blp:153
msgid "Main Menu"
msgstr "Галоўнае меню"

#: data/ui/window.blp:63
msgid "Back"
msgstr "Назад"

#: data/ui/window.blp:80
msgid "Text Type"
msgstr "Тып тэксту"

#: data/ui/window.blp:85
msgid "Mixed"
msgstr "Змешаны"

#: data/ui/window.blp:90
msgid "Auto Generation"
msgstr "Аўтаматычная генерацыя"

#: data/ui/window.blp:91
msgid "Pressing the playback button will generate the new text"
msgstr "Націсканне кнопкі прайгравання згенеруе новы тэкст"

#: data/ui/window.blp:96
msgid "Text Generation"
msgstr "Генерацыя тэксту"

#: data/ui/window.blp:98
msgid "Default word count"
msgstr "Стандартная колькасць слоў"

#: data/ui/window.blp:99
msgid "The word count is calculated automatically based on the text speed"
msgstr "Колькасць слоў лічыцца аўтаматычна, грунтуючыся на хуткасці"

#: data/ui/window.blp:103
msgid "Words"
msgstr "Словы"

#: data/ui/window.blp:108
msgid "Characters"
msgstr "Знакі"

#: data/ui/window.blp:109
msgid "Select the characters you need"
msgstr "Выберыце патрэбныя знакі"

#: data/ui/window.blp:118 data/ui/window.blp:120
msgid "Speed"
msgstr "Хуткасць"

#: data/ui/window.blp:121
msgid "The speed of the text in CPM"
msgstr "Хуткасць тэксту ў знаках за хвіліну (CPM)"

#: data/ui/window.blp:125
msgid "Delay between characters"
msgstr "Затрымка паміж знакамі"

#: data/ui/window.blp:126
msgid ""
"The delay between words is calculated automatically. The default value is 3."
msgstr ""
"Затрымка паміж словамі аблічваецца аўтаматычна. Стандартнае значэнне - 3."

#: data/ui/window.blp:159
msgid "Play"
msgstr "Прайграць"

#: data/ui/window.blp:166
msgid "Stop"
msgstr "Спыніць"

#: data/ui/window.blp:217
msgid "Copy Text"
msgstr "Скапіяваць тэкст"

#: data/ui/window.blp:222
msgid "Generate Text"
msgstr "Згенераваць тэкст"

#: data/ui/window.blp:264
msgid "Receiving Preferences"
msgstr "Налады прымання"

#: data/ui/window.blp:319
msgid "_Preferences"
msgstr "_Налады"

#: data/ui/window.blp:324
msgid "_Keyboard Shortcuts"
msgstr "_Скароты клавішаў"

#: data/ui/window.blp:329
msgid "_About Morse"
msgstr "_Аб Морзэ"

#: src/application.rs:85
msgid "Audio Error"
msgstr "Памылка аўдыё"

#: src/application.rs:87
msgid "Failed to create audio stream. Please check your audio output settings."
msgstr ""
"Не ўдалося стварыць аўдыёструмень. Калі ласка, праверце свае налады аўдыё."

